<div class="employee-app">
  <!-- Top Navigation Header -->
  <header class="app-header">
    <div class="header-container">
      <div class="brand-group">
        <div class="brand-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <div>
          <h1 class="brand-title">EmployeeBook</h1>
          <p class="brand-subtitle">Team Directory & Management</p>
        </div>
      </div>

      <div class="header-actions">
        <div class="search-wrapper">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="employeeSearch" placeholder="Search by name, role, or department..." onkeyup="filterEmployees()">
        </div>
        <button class="btn btn-primary" onclick="openAddModal()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Employee
        </button>
      </div>
    </div>
  </header>

  <main class="main-content">
    <!-- Quick Statistics Bar -->
    <section class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon bg-indigo">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
          </svg>
        </div>
        <div>
          <div class="stat-value" id="statTotal"><%= @employees.length %></div>
          <div class="stat-label">Total Staff</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon bg-emerald">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div>
          <div class="stat-value"><%= @employees.count { |e| e[:status] == "Active" } %></div>
          <div class="stat-label">Active on Duty</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon bg-amber">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div>
          <div class="stat-value"><%= @employees.count { |e| e[:status] == "On Leave" } %></div>
          <div class="stat-label">On Leave</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon bg-violet">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
          </svg>
        </div>
        <div>
          <div class="stat-value"><%= @employees.map { |e| e[:department] }.uniq.length %></div>
          <div class="stat-label">Departments</div>
        </div>
      </div>
    </section>

    <!-- Filters & View Options -->
    <div class="controls-bar">
      <div class="filter-pills" id="deptFilters">
        <button class="pill active" onclick="setDepartmentFilter('all', this)">All Teams</button>
        <button class="pill" onclick="setDepartmentFilter('Engineering', this)">Engineering</button>
        <button class="pill" onclick="setDepartmentFilter('Design', this)">Design</button>
        <button class="pill" onclick="setDepartmentFilter('Product', this)">Product</button>
        <button class="pill" onclick="setDepartmentFilter('HR', this)">HR</button>
        <button class="pill" onclick="setDepartmentFilter('Operations', this)">Operations</button>
      </div>
      <div class="view-status">
        Showing <span id="visibleCount"><%= @employees.length %></span> members
      </div>
    </div>

    <!-- Employee Cards Grid -->
    <div class="employee-grid" id="employeeGrid">
      <% @employees.each do |emp| %>
        <article class="emp-card" data-name="<%= emp[:name].downcase %>" data-role="<%= emp[:role].downcase %>" data-dept="<%= emp[:department] %>">
          <div class="emp-card-header">
            <div class="emp-avatar" style="background: <%= emp[:avatar_color] %>;">
              <%= emp[:name].split.map(&:first).join.upcase %>
            </div>
            <span class="badge <%= emp[:status] == 'Active' ? 'badge-active' : 'badge-leave' %>">
              <span class="badge-dot"></span>
              <%= emp[:status] %>
            </span>
          </div>

          <div class="emp-card-body">
            <h3 class="emp-name"><%= emp[:name] %></h3>
            <p class="emp-role"><%= emp[:role] %></p>
            <div class="dept-tag"><%= emp[:department] %></div>

            <div class="emp-contact-list">
              <div class="contact-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <span><%= emp[:email] %></span>
              </div>
              <div class="contact-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span><%= emp[:location] %></span>
              </div>
            </div>
          </div>

          <div class="emp-card-footer">
            <button class="btn-card-action" onclick="alert('Viewing profile for <%= emp[:name] %>')">View Details</button>
          </div>
        </article>
      <% end %>
    </div>
  </main>
</div>

<!-- Modal: Add New Employee -->
<div id="addModal" class="modal-overlay" onclick="handleModalBackdrop(event)">
  <div class="modal-card">
    <div class="modal-header">
      <h2>Add New Employee</h2>
      <button class="close-btn" onclick="closeAddModal()">&times;</button>
    </div>
    <form id="newEmployeeForm" onsubmit="saveEmployee(event)">
      <div class="form-group">
        <label>Full Name</label>
        <input type="text" id="empName" placeholder="e.g. Somnang Sok" required>
      </div>
      <div class="form-group">
        <label>Role / Position</label>
        <input type="text" id="empRole" placeholder="e.g. Backend Engineer" required>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Department</label>
          <select id="empDept" required>
            <option value="Engineering">Engineering</option>
            <option value="Design">Design</option>
            <option value="Product">Product</option>
            <option value="HR">HR</option>
            <option value="Operations">Operations</option>
          </select>
        </div>
        <div class="form-group">
          <label>Location</label>
          <input type="text" id="empLocation" placeholder="Phnom Penh" value="Phnom Penh" required>
        </div>
      </div>
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" id="empEmail" placeholder="name@company.kh" required>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeAddModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Member</button>
      </div>
    </form>
  </div>
</div>

<script>
  let activeDepartment = 'all';

  function filterEmployees() {
    const query = document.getElementById('employeeSearch').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.emp-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const name = card.getAttribute('data-name');
      const role = card.getAttribute('data-role');
      const dept = card.getAttribute('data-dept');

      const matchesSearch = !query || name.includes(query) || role.includes(query) || dept.toLowerCase().includes(query);
      const matchesDept = activeDepartment === 'all' || dept === activeDepartment;

      if (matchesSearch && matchesDept) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    document.getElementById('visibleCount').textContent = visibleCount;
  }

  function setDepartmentFilter(dept, element) {
    activeDepartment = dept;
    document.querySelectorAll('.filter-pills .pill').forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');
    filterEmployees();
  }

  function openAddModal() {
    document.getElementById('addModal').classList.add('open');
  }

  function closeAddModal() {
    document.getElementById('addModal').classList.remove('open');
  }

  function handleModalBackdrop(event) {
    if (event.target.id === 'addModal') {
      closeAddModal();
    }
  }

  function saveEmployee(e) {
    e.preventDefault();
    const name = document.getElementById('empName').value.trim();
    const role = document.getElementById('empRole').value.trim();
    const dept = document.getElementById('empDept').value;
    const location = document.getElementById('empLocation').value.trim();
    const email = document.getElementById('empEmail').value.trim();

    if (!name || !role || !email) return;

    const colors = ['#4f46e5', '#06b6d4', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'];
    const randomColor = colors[Math.floor(Math.random() * colors.length)];
    const initials = name.split(' ').map(n => n[0]).join('').toUpperCase();

    const grid = document.getElementById('employeeGrid');
    const newCard = document.createElement('article');
    newCard.className = 'emp-card';
    newCard.setAttribute('data-name', name.toLowerCase());
    newCard.setAttribute('data-role', role.toLowerCase());
    newCard.setAttribute('data-dept', dept);

    newCard.innerHTML = `
      <div class="emp-card-header">
        <div class="emp-avatar" style="background: ${randomColor};">
          ${initials}
        </div>
        <span class="badge badge-active">
          <span class="badge-dot"></span>
          Active
        </span>
      </div>
      <div class="emp-card-body">
        <h3 class="emp-name">${name}</h3>
        <p class="emp-role">${role}</p>
        <div class="dept-tag">${dept}</div>
        <div class="emp-contact-list">
          <div class="contact-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>${email}</span>
          </div>
          <div class="contact-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>${location}</span>
          </div>
        </div>
      </div>
      <div class="emp-card-footer">
        <button class="btn-card-action" onclick="alert('Viewing profile for ${name}')">View Details</button>
      </div>
    `;

    grid.prepend(newCard);

    // Update total counter
    const statTotal = document.getElementById('statTotal');
    if (statTotal) {
      statTotal.textContent = parseInt(statTotal.textContent || '0') + 1;
    }

    document.getElementById('newEmployeeForm').reset();
    closeAddModal();
    filterEmployees();
  }
</script>
